# Copy to .env (git-ignored) in the directory you start the services from, and fill in your own values.
# Every service reads it via spring.config.import; real environment variables take precedence.
# Never commit .env: it holds your API key and passwords.

# --- Required -------------------------------------------------------------------------------
# Your own DashScope API key (https://dashscope.console.aliyun.com). Used for chat and embeddings;
# usage is billed to this key.
API_KEY=
# MySQL password for MYSQL_USERNAME
MySQL_PASSWORD=
# Elasticsearch password for ELASTICSEARCH_USERNAME
ELASTICSEARCH_PASSWORD=
# Neo4j password for NEO4J_USERNAME (the Author/Ebook catalog; leave empty with FILECHAT_NEO4J_ENABLED=false)
NEO4J_PASSWORD=

# --- Connections (defaults shown) -----------------------------------------------------------
# MYSQL_URL=jdbc:mysql://127.0.0.1:3306/file_chat_db
# MYSQL_USERNAME=root
# ELASTICSEARCH_URIS=http://localhost:9200
# ELASTICSEARCH_USERNAME=elastic
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# FILECHAT_UPLOAD_SERVICE_URL=http://localhost:8082
# FILECHAT_AUTH_SERVICE_URL=http://localhost:8084
# Origins allowed to call the gateway from a browser (comma-separated patterns)
# FILECHAT_ALLOWED_ORIGINS=http://localhost:5173

# --- Author recommendations (Neo4j) --------------------------------------------------------------
# Recommend catalog ebooks by the authors of uploaded documents. Without Neo4j, set to false.
# FILECHAT_NEO4J_ENABLED=true
# FILECHAT_MAX_RECOMMENDATIONS=5
# Development-only /test endpoints for looking up the catalog. Never enable on a public deployment.
# FILECHAT_DEBUG_ENDPOINTS=false

# --- Model --------------------------------------------------------------------------------------
# FILECHAT_CHAT_MODEL=qwen-max
# Maximum tokens per answer
# FILECHAT_MAX_ANSWER_TOKENS=1500

# --- Cost controls (defaults shown) ------------------------------------------------------------
# Per client IP
# FILECHAT_QUESTIONS_PER_MINUTE=10
# FILECHAT_SEARCHES_PER_MINUTE=30
# FILECHAT_UPLOADS_PER_HOUR=10
# Across all users, per day: once reached, requests get 429 until midnight
# FILECHAT_QUESTIONS_PER_DAY=500
# FILECHAT_SEARCHES_PER_DAY=2000
# FILECHAT_UPLOADS_PER_DAY=100
# Largest PDF that will be embedded, in passages of up to 1024 tokens
# FILECHAT_MAX_PASSAGES_PER_UPLOAD=300
# Proxies in front of the search service that append to X-Forwarded-For (the gateway = 1).
# Add one for each reverse proxy you put in front of the gateway.
# FILECHAT_TRUSTED_PROXIES=1

# --- Network exposure ---------------------------------------------------------------------------
# The auth, search and upload services have no authentication of their own; the gateway is the only front door.
# They listen on loopback by default. Only widen this if a firewall/network policy keeps them off the internet.
# FILECHAT_BIND_ADDRESS=127.0.0.1

# --- Local infrastructure and demos (deploy/ and demo/) ------------------------------------------
# deploy/docker-compose.yml reads MySQL_PASSWORD, ELASTICSEARCH_PASSWORD and NEO4J_PASSWORD from above and refuses
# to start without them (there are no default passwords). Start it with:
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d
#
# Optional gateway API client for local use, created on the first start of an empty MySQL volume. Choose your own id
# and a long random secret (openssl rand -hex 24). The same pair is used by demo/demo.sh and file-chat-frontend.
# Letters, digits, _ and - only; the secret must be at least 16 characters.
# FILECHAT_DEMO_AUTH_ID=
# FILECHAT_DEMO_AUTH_SECRET=

# --- file-chat-frontend dev proxy (node file-chat-frontend/server.mjs) ----------------------------------
# It adds the gateway credentials to every request it forwards, so it listens on 127.0.0.1 only.
# AUTH_ID=
# AUTH_SECRET=
# GATEWAY_URL=http://localhost:8100
# HOST=127.0.0.1
# PORT=5173
