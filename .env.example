# Copy to .env (git-ignored) in the directory you start the services from, and fill in your own values.
# Every service reads it via spring.config.import; real environment variables take precedence.
# Never commit .env: it holds your API key and passwords.

# --- Required -------------------------------------------------------------------------------
# Your own DashScope API key (https://dashscope.console.aliyun.com). Used for chat and embeddings;
# usage is billed to this key.
API_KEY=
# MySQL password for MYSQL_USERNAME
MySQL_PASSWORD=
# Elasticsearch password for ELASTICSEARCH_USERNAME
ELASTICSEARCH_PASSWORD=

# --- Connections (defaults shown) -----------------------------------------------------------
# MYSQL_URL=jdbc:mysql://127.0.0.1:3306/file_chat_db
# MYSQL_USERNAME=root
# ELASTICSEARCH_URIS=http://localhost:9200
# ELASTICSEARCH_USERNAME=elastic
# FILECHAT_UPLOAD_SERVICE_URL=http://localhost:8082
# FILECHAT_AUTH_SERVICE_URL=http://localhost:8084
# Origins allowed to call the gateway from a browser (comma-separated patterns)
# FILECHAT_ALLOWED_ORIGINS=http://localhost:5173

# --- Model --------------------------------------------------------------------------------------
# FILECHAT_CHAT_MODEL=qwen-max
# Maximum tokens per answer
# FILECHAT_MAX_ANSWER_TOKENS=1500

# --- Cost controls (defaults shown) ------------------------------------------------------------
# Per client IP
# FILECHAT_QUESTIONS_PER_MINUTE=10
# FILECHAT_SEARCHES_PER_MINUTE=30
# FILECHAT_UPLOADS_PER_HOUR=10
# Across all users, per day: once reached, requests get 429 until midnight
# FILECHAT_QUESTIONS_PER_DAY=500
# FILECHAT_SEARCHES_PER_DAY=2000
# FILECHAT_UPLOADS_PER_DAY=100
# Largest PDF that will be embedded, in passages of up to 1024 tokens
# FILECHAT_MAX_PASSAGES_PER_UPLOAD=300
# Proxies in front of the search service that append to X-Forwarded-For (the gateway = 1).
# Add one for each reverse proxy you put in front of the gateway.
# FILECHAT_TRUSTED_PROXIES=1
