# Where the dev server proxies API calls (only used by `npm run dev`)
FILECHAT_GATEWAY_URL=http://localhost:8080
FILECHAT_OPENAPI_GATEWAY_URL=http://localhost:8100

# Base paths the browser calls. Override when the built app is served from a different origin
# than the gateway (remember to allow that origin with FILECHAT_ALLOWED_ORIGINS on the gateway).
VITE_API_BASE=/system
VITE_OPENAPI_BASE=/openapi
